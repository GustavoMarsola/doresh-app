# Copie para frontend/.env.local no desenvolvimento.
# Caminho da API (o Vite faz proxy de /api para o backend em :8000)
VITE_API_HOST=/api/v1
# Mesmo valor de X_API_KEY no .env da raiz
VITE_API_KEY=change-me-in-production

# Funcionalidades
# Assistente de IA Ruach — desligado por enquanto
VITE_FEATURE_RUACH=false
