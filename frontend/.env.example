# URL base da API (backend FastAPI). Em dev local o proxy do Vite já
# encaminha /api para http://localhost:8000, então normalmente basta:
VITE_API_HOST=/api/v1

# Mesma chave configurada em X_API_KEY no backend (.env da raiz do projeto).
# Necessária para os endpoints públicos: /user/register e /user/authenticate.
VITE_API_KEY=

# URL do webhook n8n usado pelo assistente Ruach (FloatingAssistant, Ruach.tsx).
# Feature ainda não tem contrapartida no backend — deixe em branco se não for usá-la.
VITE_N8N_WEBHOOK_URL=
